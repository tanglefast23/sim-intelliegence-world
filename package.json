{
  "name": "sim-intelliegence-world",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "validate:content": "tsx scripts/content/validate-content.ts",
    "check:boundaries": "tsx scripts/verification/check-import-boundaries.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "art:atlas": "tsx scripts/verification/assert-deferred-phase.ts art",
    "art:check": "npm run art:atlas",
    "export:web": "expo export --platform web",
    "test:electron": "tsx scripts/verification/assert-deferred-phase.ts electron",
    "verify": "npm run validate:content && npm run art:check && npm run check:boundaries && npm run typecheck && npm test && npm run export:web && npm run test:electron"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.8",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "57.0.11",
    "expo-audio": "57.0.3",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "jest": "29.7.0",
    "jest-expo": "57.0.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  }
}
