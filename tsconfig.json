{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "types": ["jest", "node"]
  },
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "babel.config.js",
    "metro.config.js",
    "jest.config.js",
    "electron",
    "android",
    "ios"
  ]
}
